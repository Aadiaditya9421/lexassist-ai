# Copy this file to .env and fill in your values
# Never commit .env to git

# ── LLM Provider (default: groq) ──────────────────────────────────────────
# The system defaults to Groq (free tier, Llama 3.3 70B).
# Get a free key at https://console.groq.com
GROQ_API_KEY=gsk_...your-key-here...

# Optional: use OpenAI instead (set llm_provider="openai" in config.py)
OPENAI_API_KEY=sk-...your-key-here...

# Optional: override defaults from config.py
# LLM_MODEL=gpt-4o-mini
# FAITHFULNESS_THRESHOLD=0.50
